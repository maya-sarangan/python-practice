{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 practice.py:*)",
      "Bash(python3 tools/make_stubs.py:*)",
      "Bash(python3 tools/fcc_lesson.py:*)",
      "Bash(tools/gate_hook.sh:*)"
    ],
    "ask": [
      "Bash(python3 tools/make_stubs.py --force)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/gate_hook.sh\"",
            "timeout": 120,
            "statusMessage": "Verifying the quest answer key..."
          }
        ]
      }
    ]
  }
}
